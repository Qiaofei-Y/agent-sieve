# EditorConfig  https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json,toml,cfg,ini}]
indent_size = 2

[Makefile]
indent_style = tab

# Markdown 保留行尾两个空格的硬换行 / keep trailing-whitespace hard line breaks
[*.md]
trim_trailing_whitespace = false
